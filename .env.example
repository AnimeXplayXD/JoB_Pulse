# GEMINI_API_KEY: Optional key for Gemini API integration.
# This is a placeholder key for local development.
# Configure this via your local environment variables or local.properties.
# IMPORTANT: Uncomment the line below if your build uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# API_URL: The base URL for the production recruitment API.
# IMPORTANT: Provide this URL to connect the app to the live backend.
# If left commented out or empty, the app will fall back to local development fixtures (in DEBUG) 
# or an UnconfiguredDataSource (in RELEASE).
API_URL="https://api.example.com/"
